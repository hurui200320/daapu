{
  // Editor support: IDEs that understand JSON schema (VSCode, IntelliJ)
  // validate and autocomplete this file against config.schema.json.
  // Copy this file to config.jsonc and fill in your values (the schema
  // file and this example are checked in; config.jsonc is gitignored
  // because it holds API keys).
  "$schema": "./config.schema.json",
  // PostgreSQL connection (pgvector enabled), see db/Database.kt
  "database": {
    "url": "jdbc:postgresql://localhost:5432/postgres",
    "user": "postgres",
    "password": "postgres"
  },
  // The OpenAI-compatible LLM gateway(s); each baseUrl should end with /v1.
  // The MODEL CATALOG lives here too: "llm" entries are the chat models the
  // UI can select per message ("llm[].modelId" joins the provider key into
  // the wire-visible id "{provider}/{modelId}"), "embedding" entries are
  // referenced by memory.eltm.embeddingModel. At least one "llm" entry is
  // REQUIRED overall (the empty-catalog case fails fast at boot), and every
  // entry's fields are required: contextLength/maxOutputTokens budget the
  // run loop's exhaustion classification, capabilities gate attachments and
  // tool loops ("image", "video", "audio", "document", "tool_calls",
  // "reasoning:<effort>" with effort minimal/low/medium/high/xhigh/max;
  // at most one "reasoning:" entry per model),
  // compactionTriggerFraction/compactionKeepRounds tune per-model proactive
  // compaction. Duplicate composite ids fail fast at boot.
  "providers": {
    "bifrost": {
      "apiKey": "replace-me",
      "baseUrl": "http://localhost:8000/v1",
      "llm": [
        {
          "modelId": "cerebras/gpt-oss-120b",
          "contextLength": 131000,
          "maxOutputTokens": 40000,
          "capabilities": ["reasoning:high", "tool_calls"],
          "compactionTriggerFraction": 0.75,
          "compactionKeepRounds": 2
        },
        {
          "modelId": "cerebras/gemma-4-31b",
          "contextLength": 131072,
          "maxOutputTokens": 40000,
          "capabilities": ["image", "reasoning:high", "tool_calls"],
          "compactionTriggerFraction": 0.75,
          "compactionKeepRounds": 2
        },
        {
          "modelId": "novita/google/gemma-4-31b-it",
          "contextLength": 262144,
          "maxOutputTokens": 131072,
          "capabilities": ["image", "reasoning:high", "tool_calls"],
          "compactionTriggerFraction": 0.8,
          "compactionKeepRounds": 3
        }
      ],
      // The embedding entry's dimensions pin the output size of every
      // /v1/embed request (this gateway honors a dimensions request field);
      // for other providers check the dimensions field first. Must stay
      // <= 2000 (pgvector's HNSW limit — the ELTM columns are vector(2000)
      // and shorter vectors are zero-padded).
      "embedding": [
        {
          "modelId": "zenmux sub/google/gemini-embedding-2",
          "dimensions": 1536
        }
      ]
    },
    // A second gateway may carry only one kind of entry; it can be removed
    // entirely when unused. In this example memory.eltm.embeddingModel below
    // references the BIFROST embedding entry — this block only shows an
    // embedding-only provider (deepinfra's own Qwen embeddings would need
    // its id here to be served).
    "deepinfra": {
      "apiKey": "replace-me",
      "baseUrl": "https://api.deepinfra.com/v1/openai/",
      "embedding": [
        {
          "modelId": "Qwen/Qwen3-Embedding-8B",
          "dimensions": 1536,
          // Optional extra root-level fields merged into every /v1/embed
          // gateway request body (gateway-specific knobs; keys colliding
          // with the hand-managed model/input/dimensions fail at boot):
          // "additionalProperties": { "service_tier": "priority" }
        }
      ]
    }
  },
  // The HTTP API server; the frontend dev server proxies /api to this port
  "server": {
    "port": 8080
  },
  // MCP tool servers, all tools advertised to every chat run. The provider
  // connects eagerly at startup, so a server that cannot be reached aborts
  // startup instead of silently degrading every chat run.
  "mcp": {
    // The dedicated exa server, REQUIRED: the namespace "exa" is hardcoded
    // (advertised tool names become exa__web_search_exa, ...) — the user
    // fills the rest, exactly like an mcp.customs entry. Streamable HTTP
    // against the hosted endpoint, with the exa API key as a Bearer header.
    "exa": {
      "type": "http",
      "url": "https://mcp.exa.ai/mcp?tools=web_search_exa,web_fetch_exa,web_search_advanced_exa",
      "headers": {
        "Authorization": "Bearer replace-me"
      },
      "toolExecutionTimeoutSeconds": 120
    },
    // Every other MCP server, keyed by namespace (the key is the namespace
    // prefix of the advertised tool names, e.g. fs__read; "exa" is reserved
    // for the dedicated exa server above). Every server MUST provide
    // toolExecutionTimeoutSeconds (the execution budget of each tool in
    // seconds; 0 = no timeout).
    "customs": {
      // stdio example: a local subprocess (command + optional
      // environment); uncomment and adapt to use it
      // "fs": {
      //     "type": "stdio",
      //     "command": ["npx", "-y", "@modelcontextprotocol/server-filesystem", "/tmp"],
      //     "toolExecutionTimeoutSeconds": 60
      // }
    },
    // Optional HTTP proxy for ALL http-type MCP servers (stdio is
    // unaffected): every request (initialize, tool POST, SSE GET, DELETE)
    // tunnels through it via CONNECT. Explicit only — HTTP_PROXY-style env
    // vars are NOT picked up. The proxy config model has no authentication
    // fields. Uncomment and adapt to use it:
    // "proxy": {
    //   "host": "127.0.0.1",
    //   "port": 7890
    // }
  },
  // The harness-owned tool providers (agent/tool/filesystem/FsToolProvider.kt):
  // the read-only filesystem provider, a local mock of the read-only tools of
  // the vanilla filesystem MCP server (which has no read-only mode). The
  // namespace is hardcoded to "fs" (advertised tool names fs__read_text_file,
  // ...), so it CANNOT coexist with an MCP server under the same "fs"
  // namespace (enabling both fails fast at boot on the duplicate namespace):
  // for read-WRITE filesystem access, use the vanilla filesystem MCP server
  // instead and keep this disabled. All fields are ignored while disabled.
  "tool": {
    "fs": {
      "enabled": false,
      // The directories the LLM may access; REQUIRED non-empty when enabled.
      // "~" is expanded; each directory must exist at boot (a typo'd path
      // aborts startup).
      "allowedDirs": ["~/Documents"],
      // Glob patterns (blob/gitignore syntax) matched against paths relative
      // to the allowed dirs: a blocked path is refused as the TARGET of a
      // tool call (reading a blocked file, listing a blocked folder, ...);
      // listing/search results that merely contain blocked entries are
      // returned as-is. The investigate sub-agent can whitelist this
      // namespace via agent.investigator.allowedNamespaces.
      "blacklists": ["**/.env", "**/*.env", "secrets/**"]
    }
  },
  // The memory pipeline: compaction + the ELTM. The model ids are REQUIRED
  // (resolved once at startup and reused for every run; a chat run's own
  // model is never used for these). They reference the catalog; the writer
  // model must support tool calls. The compaction trigger fraction and keep
  // rounds are per-model (agent/model/LLM.kt).
  "memory": {
    "compactModel": "bifrost/cerebras/gemma-4-31b",
    // The ELTM (external long-term memory, diary model): REQUIRED. The model
    // ids are resolved once at startup; the writer model must support tool
    // calls. The embedding model's output dimensions must not
    // exceed 2000 (pgvector's HNSW limit): the ELTM vector columns are fixed
    // at vector(2000) and shorter vectors are zero-padded on write (cosine is
    // invariant under zero-padding), so switching embedding models never
    // needs a schema change.
    "eltm": {
      // The memory extractor (agent/oneshot/eltm/MemoryExtractionService.kt):
      // sees the raw dropped history, images included; no tool calls.
      "extractionModel": "bifrost/cerebras/gemma-4-31b",
      "embeddingModel": "bifrost/zenmux sub/google/gemini-embedding-2",
      "writerModel": "bifrost/cerebras/gemma-4-31b",
      // Query rewrite one-shot (agent/oneshot/rewrite/QueryRewriteService.kt):
      // rewrites the run's latest input into standalone retrieval queries.
      "rewriteModel": "bifrost/cerebras/gemma-4-31b",
      // How many trailing user rounds of the chat feed the rewrite.
      // REQUIRED (related to the rewrite model's context size).
      "rewriteRounds": 5,
      // How many related entities the ELTM context injection puts into the
      // <memories>' <related-entities> (the injection size is related to the
      // main model's context). REQUIRED; 0 = skip the entity search.
      "relatedEntitiesLimit": 5,
      // How many related diary notes the ELTM context injection puts into
      // <memories>' <related-notes>. REQUIRED; 0 = skip the note search
      // (with both limits 0 the rewrite one-shot is skipped too).
      "relatedNotesLimit": 5,
      // Cosine floor for create_entity near-match candidates (0..1).
      "entityMatchThreshold": 0.5,
      // Cosine floor for search_notes (0..1).
      "noteSearchThreshold": 0.1,
      // Round cap for the ELTM writer tool loop; 0 = unlimited.
      "maxWriterRounds": 150
    }
  },
  // The agents: the main (chat loop) agent and the investigate agent
  // (agent/oneshot/investigate/InvestigatorService.kt), a tool loop that
  // gathers information from the ELTM (read-only) and the web (MCP tools)
  // on behalf of the main agent (which reaches it through the single
  // `gsg__investigate` tool). The model id is REQUIRED (resolved once at
  // startup; must support tool calls); allowedNamespaces is the sub-agent's
  // tool whitelist over its OWN tool set (the read-only "eltm" tools plus
  // the MCP servers, built separately from the chat loop's set): REQUIRED,
  // non-empty, and every entry must be a namespace that set serves (a typo
  // — or whitelisting "gsg" itself, which would enable recursion — fails
  // fast at boot).
  "agent": {
    // The main (chat loop) agent: every successful tool result the loop's
    // model sees is capped at toolResultLimit chars (merged text truncated
    // to the cap, marker budgeted inside it — a cap too small to hold the
    // marker, unusable for real tool results anyway, yields the marker
    // alone). Chars, not tokens, by design (token estimation is
    // unreliable across providers/models); error results are never
    // truncated (they are short failure descriptions the model needs
    // verbatim to recover). Must be positive.
    "main": {
      "toolResultLimit": 40000
    },
    "investigator": {
      "model": "bifrost/cerebras/gemma-4-31b",
      // Round cap for the investigate tool loop; 0 = unlimited.
      "maxRounds": 150,
      // The namespaces the sub-agent may execute; entries validated like any
      // tool namespace (only [0-9a-z_-], no "__").
      "allowedNamespaces": ["eltm", "exa"],
      // The sub-agent's own tool-result truncation cap, like
      // agent.main.toolResultLimit (chars, not tokens, by design; error
      // results are never truncated). Must be positive.
      "toolResultLimit": 40000
    }
  },
  // Session-title generation (agent/oneshot/TitleGenerator.kt): the model id
  // is REQUIRED and resolved once at startup, like the memory pipeline
  // models; it is never the chat run's own model. lastNRound caps the
  // history fed to the title model to the last N user rounds (0 = all).
  "title": {
    "model": "bifrost/cerebras/gemma-4-31b",
    "lastNRound": 0
  },
  // The hand-pi execution service (hand-pi/): a stateless
  // Node service that owns LLM execution (streaming, dialects, tool-call
  // accumulation, retries, usage). Run it with the same token:
  //   HAND_PORT=3100 HAND_TOKEN=dev-token npm --prefix hand-pi start
  // The run-policy knobs are REQUIRED per request (the hand holds no
  // defaults) and sent with every run; the values below mirror the
  // previous hand-side defaults.
  "hand": {
    "baseUrl": "http://127.0.0.1:3100",
    "token": "dev-token",
    // Round cap per /v1/run; 0 = unlimited.
    "maxRounds": 64,
    // Transient retries per round; 0 = unlimited.
    "maxRetries": 0,
    // Stream idle timeout per round in ms; 0 = disabled.
    "streamIdleTimeoutMs": 300000
  }
}
