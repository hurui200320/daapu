{
  // Editor support: IDEs that understand JSON schema (VSCode, IntelliJ)
  // validate and autocomplete this file against config.schema.json.
  // Copy this file to config.jsonc and fill in your values (the schema
  // file and this example are checked in; config.jsonc is gitignored
  // because it holds API keys).
  "$schema": "./config.schema.json",
  // PostgreSQL connection (pgvector enabled), see db/Database.kt
  "database": {
    "url": "jdbc:postgresql://localhost:5432/postgres",
    "user": "postgres",
    "password": "postgres"
  },
  // The OpenAI-compatible LLM gateway; should end with /v1
  "providers": {
    "bifrost": {
      "apiKey": "replace-me",
      "baseUrl": "http://localhost:8000/v1"
    }
  },
  // The HTTP API server; the frontend dev server proxies /api to this port
  "server": {
    "port": 8080
  },
  // MCP tool servers, all tools advertised to every chat run. The provider
  // connects eagerly at startup, so a server that cannot be reached aborts
  // startup instead of silently degrading every chat run.
  "mcp": {
    "servers": [
      {
        // Streamable HTTP server: url + optional headers. Every server MUST
        // provide toolExecutionTimeoutSeconds (the execution budget of each
        // tool in seconds; 0 = no timeout).
        "namespace": "exa",
        "type": "http",
        "url": "https://mcp.exa.ai/mcp?tools=web_search_exa,web_fetch_exa,web_search_advanced_exa",
        "headers": {
          "Authorization": "Bearer replace-me"
        },
        "toolExecutionTimeoutSeconds": 120
      }
      // stdio example: a local subprocess (command + optional
      // environment); uncomment and adapt to use it
      // {
      //     "namespace": "fs",
      //     "type": "stdio",
      //     "command": ["npx", "-y", "@modelcontextprotocol/server-filesystem", "/tmp"],
      //     "toolExecutionTimeoutSeconds": 60
      // }
    ]
  },
  // The memory pipeline: compaction + SSTM extraction + the ELTM. The model
  // ids are REQUIRED (resolved once at startup and reused for every run; a
  // chat run's own model is never used for these). They reference the
  // catalog; the merge, writer and recall models must support tool calls.
  // The compaction trigger fraction and keep rounds are per-model
  // (agent/model/LLM.kt).
  "memory": {
    "compactModel": "bifrost/cerebras/gemma-4-31b",
    // The SSTM (short-term memory): the extractor/merger that write it and
    // the capacity/purge knobs that evict it into the ELTM (the only
    // eviction path; the SSTM is always fully in context).
    "sstm": {
      "extractModel": "bifrost/cerebras/gemma-4-31b",
      "mergeModel": "bifrost/cerebras/gemma-4-31b",
      // Round cap for the memory merge tool loop; 0 = unlimited.
      "maxMergeRounds": 150,
      // SSTM capacity: the total char length of all memory contents; when
      // the SSTM exceeds it, the oldest entries are purged into the ELTM.
      "maxCapacity": 10000,
      // How many SSTM entries one purge batch moves into the ELTM.
      "purgeBatchSize": 20
    },
    // The ELTM (external long-term memory, diary model): REQUIRED. The three
    // model ids are resolved once at startup; the writer and recall models
    // must support tool calls. The embedding model's output dimensions must
    // not exceed 2000 (pgvector's HNSW limit): the ELTM vector columns are
    // fixed at vector(2000) and shorter vectors are zero-padded on write
    // (cosine is invariant under zero-padding), so switching embedding
    // models never needs a schema change.
    "eltm": {
      "embeddingModel": "bifrost/zenmux sub/google/gemini-embedding-2",
      "writerModel": "bifrost/cerebras/gemma-4-31b",
      "recallModel": "bifrost/cerebras/gemma-4-31b",
      // Cosine floor for create_entity near-match candidates (0..1).
      "entityMatchThreshold": 0.5,
      // Cosine floor for search_notes (0..1).
      "noteSearchThreshold": 0.1,
      // Execution budget of one recall tool call in seconds; 0 = none.
      "recallTimeoutSeconds": 300,
      // Round cap for the ELTM writer tool loop; 0 = unlimited.
      "maxWriterRounds": 150
    }
  },
  // Session-title generation (agent/oneshot/TitleGenerator.kt): the model id
  // is REQUIRED and resolved once at startup, like the memory pipeline
  // models; it is never the chat run's own model. lastNRound caps the
  // history fed to the title model to the last N user rounds (0 = all).
  "title": {
    "model": "bifrost/cerebras/gemma-4-31b",
    "lastNRound": 0
  },
  // The hand-pi execution service (hand-pi/): a stateless
  // Node service that owns LLM execution (streaming, dialects, tool-call
  // accumulation, retries, usage). Run it with the same token:
  //   HAND_PORT=3100 HAND_TOKEN=dev-token npm --prefix hand-pi start
  // The run-policy knobs are REQUIRED per request (the hand holds no
  // defaults) and sent with every run; the values below mirror the
  // previous hand-side defaults.
  "hand": {
    "baseUrl": "http://127.0.0.1:3100",
    "token": "dev-token",
    // Round cap per /v1/run; 0 = unlimited.
    "maxRounds": 64,
    // Transient retries per round; 0 = unlimited.
    "maxRetries": 0,
    // Stream idle timeout per round in ms; 0 = disabled.
    "streamIdleTimeoutMs": 300000
  }
}
