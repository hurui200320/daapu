{
  // Editor support: IDEs that understand JSON schema (VSCode, IntelliJ)
  // validate and autocomplete this file against config.schema.json.
  // Copy this file to config.jsonc and fill in your values (the schema
  // file and this example are checked in; config.jsonc is gitignored
  // because it holds API keys).
  "$schema": "./config.schema.json",
  // PostgreSQL connection (pgvector enabled), see db/Database.kt
  "database": {
    "url": "jdbc:postgresql://localhost:5432/postgres",
    "user": "postgres",
    "password": "postgres"
  },
  // The OpenAI-compatible LLM gateway; should end with /v1
  "providers": {
    "bifrost": {
      "apiKey": "replace-me",
      "baseUrl": "http://localhost:8000/v1"
    }
  },
  // The HTTP API server; the frontend dev server proxies /api to this port
  "server": {
    "port": 8080
  },
  // MCP tool servers, all tools advertised to every chat run. The provider
  // connects eagerly at startup, so a server that cannot be reached aborts
  // startup instead of silently degrading every chat run.
  "mcp": {
    "servers": [
      {
        // Streamable HTTP server: url + optional headers
        "namespace": "exa",
        "type": "http",
        "url": "https://mcp.exa.ai/mcp?tools=web_search_exa,web_fetch_exa,web_search_advanced_exa",
        "headers": {
          "Authorization": "Bearer replace-me"
        }
      }
      // stdio example: a local subprocess (command + optional
      // environment); uncomment and adapt to use it
      // {
      //     "namespace": "fs",
      //     "type": "stdio",
      //     "command": ["npx", "-y", "@modelcontextprotocol/server-filesystem", "/tmp"]
      // }
    ]
  },
  // The memory pipeline: history compaction and SSTM extraction. The model
  // ids reference the catalog; omitting one (or setting null) uses the run's
  // model for that step.
  "memory": {
    // compact when the estimated prompt exceeds this fraction of the model's
    // context window (0 disables the proactive path)
    "compactionTriggerFraction": 0.8,
    // complete rounds kept verbatim at the tail of a compacted chat
    "compactionKeepRounds": 3
    // "compactModel": "bifrost/cerebras/gemma-4-31b",
    // "extractModel": "bifrost/cerebras/gemma-4-31b",
    // "mergeModel": "bifrost/cerebras/gemma-4-31b"
  },
  // The hand-pi execution service (hand-pi/): a stateless
  // Node service that owns LLM execution (streaming, dialects, tool-call
  // accumulation, retries, usage). Run it with the same token:
  //   HAND_PORT=3100 HAND_TOKEN=dev-token npm --prefix hand-pi start
  "hand": {
    "baseUrl": "http://127.0.0.1:3100",
    "token": "dev-token"
  }
}
