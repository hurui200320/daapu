<?xml version="1.0" encoding="UTF-8"?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema">
    <!-- root node: injection -->
    <xs:element name="injection">
        <xs:complexType>
            <xs:sequence>

                <!-- The FULL injection shape (a persona whose whitelist serves
                     `gsg`): real-time-info with localtime AND eltm-updated, plus
                     the memories section. The time-only SIMPLE shape (a persona
                     without `gsg` access, the one-shot rewrite) lives in
                     injectionSimpleSchema.xsd. The two shapes are deliberately
                     kept in separate schemas: XSD 1.0 cannot express the pairing
                     (both shapes start with `real-time-info`, so a xs:choice of
                     them would be UPA-ambiguous), and the generator emits exactly
                     these two shapes — a hybrid (eltm-updated without memories,
                     or memories without eltm-updated) is invalid in BOTH schemas
                     and survives as user content. -->
                <!-- real-time-info -->
                <xs:element name="real-time-info">
                    <xs:complexType>
                        <xs:sequence>
                            <!-- localtime, string -->
                            <xs:element name="localtime" type="xs:string"/>
                            <!-- eltm-updated, boolean -->
                            <xs:element name="eltm-updated" type="xs:boolean"/>
                        </xs:sequence>
                    </xs:complexType>
                </xs:element>

                <!-- memories -->
                <xs:element name="memories">
                    <xs:complexType>
                        <xs:sequence>
                            <!-- the ELTM context injection: retrieved entities and diary notes (always present, possibly empty) -->
                            <xs:element name="related-entities" minOccurs="0">
                                <xs:complexType>
                                    <xs:sequence>
                                        <!-- entity, 0 to unlimited items -->
                                        <xs:element name="entity" minOccurs="0" maxOccurs="unbounded">
                                            <xs:complexType>
                                                <xs:sequence>
                                                    <!-- attribute, 0 to unlimited items: current-state facts as key/value pairs -->
                                                    <xs:element name="attribute" minOccurs="0" maxOccurs="unbounded">
                                                        <xs:complexType>
                                                            <xs:simpleContent>
                                                                <xs:extension base="xs:string">
                                                                    <xs:attribute name="key" type="xs:string" use="required"/>
                                                                </xs:extension>
                                                            </xs:simpleContent>
                                                        </xs:complexType>
                                                    </xs:element>
                                                </xs:sequence>
                                                <xs:attribute name="id" type="xs:long" use="required"/>
                                                <xs:attribute name="name" type="xs:string" use="required"/>
                                                <xs:attribute name="category" type="xs:string" use="required"/>
                                            </xs:complexType>
                                        </xs:element>
                                    </xs:sequence>
                                </xs:complexType>
                            </xs:element>
                            <xs:element name="related-notes" minOccurs="0">
                                <xs:complexType>
                                    <xs:sequence>
                                        <!-- note, 0 to unlimited items: a dated diary entry whose subject is identified by names -->
                                        <xs:element name="note" minOccurs="0" maxOccurs="unbounded">
                                            <xs:complexType>
                                                <xs:simpleContent>
                                                    <xs:extension base="xs:string">
                                                        <xs:attribute name="id" type="xs:long" use="required"/>
                                                        <xs:attribute name="date" type="xs:string" use="required"/>
                                                        <xs:attribute name="subject-type" type="xs:string" use="required"/>
                                                        <!-- the subject is ONE entity (name+category) XOR ONE relationship
                                                             (src-name+verb+dst-name); the union is declared because XSD 1.0
                                                             cannot express the XOR, the generator always emits exactly one set -->
                                                        <xs:attribute name="name" type="xs:string"/>
                                                        <xs:attribute name="category" type="xs:string"/>
                                                        <xs:attribute name="src-name" type="xs:string"/>
                                                        <xs:attribute name="verb" type="xs:string"/>
                                                        <xs:attribute name="dst-name" type="xs:string"/>
                                                    </xs:extension>
                                                </xs:simpleContent>
                                            </xs:complexType>
                                        </xs:element>
                                    </xs:sequence>
                                </xs:complexType>
                            </xs:element>
                        </xs:sequence>
                    </xs:complexType>
                </xs:element>

            </xs:sequence>
        </xs:complexType>
    </xs:element>

</xs:schema>