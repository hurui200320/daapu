{
  "name": "hand-pi",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Stateless LLM execution service for daapu, replacing langchain4j execution.",
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc -p tsconfig.test.json",
    "lint": "prettier --check . && eslint .",
    "fmt": "prettier --write .",
    "start": "node dist/main.js",
    "dev": "tsx watch src/main.ts",
    "test": "vitest run"
  },
  "dependencies": {
    "@earendil-works/pi-ai": "0.84.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.9.1",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^16.5.0",
    "prettier": "^3.9.6",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.68.0",
    "vitest": "^4.0.0"
  }
}
